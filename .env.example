# ===== Sahati Medical Center - Enterprise Config =====
# Required - copy these into Render Dashboard Environment

# Primary identifier of your medical center (appears on every report)
CENTER_NAME=مركز صحتي

# Official legal/medical entity name (used in PDF + footer)
CENTER_FULL_NAME=مركز صحتي الطبي التخصصي

# Department name (e.g. internal medicine, pediatrics)
CENTER_INSTITUTION=مستشفى

# City
CENTER_CITY=الرياض

# License/registration number (printed on official seal)
CENTER_LICENSE=MOH-2026-887412

# Default doctor shown in the form placeholder
DOCTOR_DEFAULT=د. خالد العتيبي

# Public base URL - REQUIRED for QR scan to reach verify page
# E.g. https://sahati-medical.onrender.com
VERIFY_BASE=

# ===== Optional: Scheduled Status Auto-Lifecycle =====
# If true, a cron task runs once daily to auto-expire Active records
# that passed their discharge_date, AND auto-SMS the patient.
# On Render's free tier, the instance may sleep — keep cron timer
# safe to re-schedule when the process wakes.
# RUN_CRON=true

# ===== Optional: SMS Gateways =====
# A) Taqnyat (Saudi Arabia): https://developer.taqnyat.sa/
TAQNYAT_TOKEN=
TAQNYAT_SENDER=SahatiMed

# B) Twilio (Global): https://twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# C) WhatsApp Business via Twilio
WHATSAPP_FROM_NUMBER=
